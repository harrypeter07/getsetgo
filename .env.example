# ─── Supabase ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# ─── Backblaze B2 (private bucket, no credit card required) ───────────────────
B2_KEY_ID=your-b2-key-id
B2_APPLICATION_KEY=your-b2-application-key
B2_BUCKET_NAME=your-bucket-name
B2_ENDPOINT=s3.us-east-005.backblazeb2.com   # varies by region

# ─── Cloudflare Worker proxy (public-facing stream URL) ───────────────────────
NEXT_PUBLIC_STREAM_BASE_URL=https://videostream-proxy.YOUR-SUBDOMAIN.workers.dev
